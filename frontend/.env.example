# ==============================================================================
# MICHI Frontend Environment Variables
# ==============================================================================

# Supabase Client Configuration
# Obtain from Supabase Project Settings > API
# Publishable key (sb_publishable_...) or legacy anon key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Base URL (default connects to local Vite proxy -> http://localhost:8000)
VITE_API_BASE_URL=/api/v1

# Geoapify Client Key (Phase 4 Maps & Route Planning with MapLibre GL)
# Optional client key for Geoapify vector tiles & client-side road routing fallback
VITE_GEOAPIFY_API_KEY=your-geoapify-api-key
